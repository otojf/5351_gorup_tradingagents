{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cs5351/tradingagents/docs/req/req-schema.json",
  "title": "CS5351 Requirements Registry",
  "description": "Schema for docs/req/requirements.yaml. Every requirement is an entry with an ID, type, statement, a machine-checkable fit criterion, and a priority. Non-functional requirements are metric + threshold + verification. Supporting requirements (FR-E1/FR-E2/FR-E3/INV-E1 under NFR-E1) are nested entries that carry the same fields and may be lifted to top level later after team/instructor confirmation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "updated", "requirements"],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Registry schema version.",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "updated": {
      "type": "string",
      "description": "Last update date, YYYY-MM-DD.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source_document": {
      "type": "string"
    },
    "options_file": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(FR|NFR|INV)-(?:[A-Z][0-9]+|(?:GOV|SEC)-[0-9]+)$",
      "description": "Requirement ID: FR-A1, NFR-E1, INV-E1, and governance/security IDs like NFR-GOV-01 / NFR-SEC-01."
    },
    "type": {
      "type": "string",
      "enum": ["functional", "invariant", "non_functional"]
    },
    "category": {
      "type": "string",
      "enum": [
        "functional_behavior",
        "invariant",
        "quality_attribute",
        "performance",
        "cost",
        "governance",
        "security"
      ]
    },
    "priority": {
      "type": "string",
      "enum": ["must", "should", "could", "wont"]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "partial", "implemented", "optional"]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test", "monitor", "demo"],
      "description": "Each requirement links to at least one test, one runtime monitor, and one demo moment.",
      "properties": {
        "test": { "type": "string", "minLength": 1 },
        "monitor": { "type": "string", "minLength": 1 },
        "demo": { "type": "string", "minLength": 1 }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "category",
        "statement",
        "fit_criterion",
        "priority",
        "owner",
        "component",
        "verification",
        "status"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "$ref": "#/$defs/type" },
        "category": { "$ref": "#/$defs/category" },
        "statement": { "type": "string", "minLength": 1 },
        "fit_criterion": {
          "type": "string",
          "minLength": 1,
          "description": "Machine-checkable acceptance criterion with metric + threshold + verification."
        },
        "priority": { "$ref": "#/$defs/priority" },
        "owner": {
          "type": "string",
          "pattern": "^[A-Z]$"
        },
        "component": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "verification": { "$ref": "#/$defs/verification" },
        "status": { "$ref": "#/$defs/status" },
        "supporting_requirements": {
          "type": "array",
          "description": "Supporting requirements: either a bare ID (reference only) or a full nested entry. NFR-E1 uses full nested entries; other primaries currently reference bare IDs. Whether nested entries are lifted to top level is pending team/instructor confirmation.",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/id" },
              { "$ref": "#/$defs/supporting_requirement" }
            ]
          }
        }
      }
    },
    "supporting_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "statement",
        "fit_criterion",
        "verification",
        "status"
      ],
      "description": "A nested supporting requirement under a primary requirement. Same machine-checkable shape as a top-level requirement minus priority/owner/component, which are inherited from the parent unless stated.",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "$ref": "#/$defs/type" },
        "category": { "$ref": "#/$defs/category" },
        "statement": { "type": "string", "minLength": 1 },
        "fit_criterion": { "type": "string", "minLength": 1 },
        "priority": { "$ref": "#/$defs/priority" },
        "owner": {
          "type": "string",
          "pattern": "^[A-Z]$"
        },
        "component": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "verification": { "$ref": "#/$defs/verification" },
        "status": { "$ref": "#/$defs/status" }
      }
    }
  }
}
